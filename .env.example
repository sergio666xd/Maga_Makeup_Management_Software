# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local.
# Con Supabase local (pnpm supabase start), los valores salen de `pnpm supabase status`.

# --- Frontend (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend (FastAPI) ---
SUPABASE_URL=http://127.0.0.1:54321
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Cloud API de Meta (ver docs/decisiones/0002-whatsapp-cloud-api.md) ---
# En local déjalos vacíos: las pruebas usan un doble y no llaman a Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
